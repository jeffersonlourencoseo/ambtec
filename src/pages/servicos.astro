---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../data/config.ts';

const todosServicos = await getCollection('servicos');
const servicos = [
  todosServicos.find(s => s.slug === 'licenciamento-ambiental'),
  ...todosServicos.filter(s => s.slug !== 'licenciamento-ambiental')
].filter(Boolean);
---

<Layout
  title="Serviços de Consultoria Ambiental no Rio de Janeiro"
  description={`Serviços da ${SITE_CONFIG.company.shortName} no Rio de Janeiro: licenciamento ambiental, supressão vegetal e poda, inventário florestal, compensação ambiental e reflorestamento, com a mesma equipe técnica.`}
>
  <Fragment slot="header"><Header /></Fragment>

  <PageHero eyebrow="Serviços" image>
    <h1 class="rise rise-2 text-display-xl font-bold text-white">
      Serviços de Consultoria Ambiental <em class="text-accent-gold">no Rio de Janeiro</em>
    </h1>
    <h2 class="rise rise-3 mt-8 max-w-3xl text-[clamp(1.15rem,1.6vw,1.35rem)] font-semibold tracking-[-0.02em] leading-snug text-white/85">
      Do licenciamento à execução: <span class="text-accent-gold">técnica, protocolo e campo</span> em um só lugar
    </h2>
    <p class="rise rise-4 mt-7 max-w-2xl text-lg leading-relaxed text-white/60">
      O <strong class="font-semibold text-white/90">licenciamento ambiental</strong> é o núcleo da regularização. Para licenciar, seu empreendimento pode precisar de compensação ambiental, inventário florestal, poda de árvores autorizada ou reflorestamento. Na Ambtec, tudo isso está em um só lugar — técnica, burocracia e execução prática interligadas.
    </p>
  </PageHero>

  <!-- LISTA DE SERVIÇOS -->
  <section class="section-luxury">
    <div class="section-inner">
      <div class="reveal mb-12 flex flex-wrap items-end justify-between gap-6">
        <div>
          <span class="eyebrow">{servicos.length} especialidades interligadas</span>
          <p class="mt-5 max-w-xl text-display-sm font-semibold text-neutral-ink">Uma equipe, um cronograma, do protocolo à execução em campo.</p>
        </div>
        <a href="/contato" class="btn-luxury-outline">Não sabe qual precisa? Fale conosco</a>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {servicos.map((servico, i) => (
          <a
            href={`/servicos/${servico.slug}`}
            class:list={[
              'reveal group relative flex min-h-[20rem] flex-col overflow-hidden rounded-[1.75rem] p-7 transition-all duration-500 ease-out-expo hover:-translate-y-1 md:p-8',
              i === 0 ? 'bg-brand-deep text-white md:col-span-2' : 'card hover:shadow-lift',
            ]}
          >
            {i === 0 && (
              <>
                <img src="/images/hero-ambiental.webp" alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-35 transition-transform duration-[1.2s] ease-out-expo group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-r from-brand-night via-brand-night/80 to-transparent"></div>
              </>
            )}
            <div class="relative flex items-start justify-between">
              <span class={i === 0 ? 'icon-tile-dark' : 'icon-tile'}>
                {servico.data.icon && (
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={servico.data.icon} /></svg>
                )}
              </span>
              <span class:list={['inline-flex h-11 w-11 items-center justify-center rounded-full transition-all duration-500 ease-out-expo group-hover:rotate-[-45deg]', i === 0 ? 'bg-accent-gold text-brand-night' : 'bg-neutral-cream text-neutral-ink group-hover:bg-brand-deep group-hover:text-accent-gold']}>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
              </span>
            </div>
            <div class="relative mt-auto pt-12">
              <span class:list={['text-sm font-semibold', i === 0 ? 'text-accent-gold' : 'text-brand-mid']}>0{i + 1}</span>
              <h2 class:list={['mt-2 font-bold leading-tight tracking-[-0.03em]', i === 0 ? 'text-[2rem] text-white md:text-[2.4rem]' : 'text-[1.4rem] text-neutral-ink']}>{servico.data.title}</h2>
              <p class:list={['mt-3 max-w-xl leading-relaxed line-clamp-3', i === 0 ? 'text-white/65' : 'text-neutral-ink-muted']}>{servico.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-luxury !pt-4">
    <div class="section-inner">
      <div class="reveal flex flex-col gap-10 rounded-[2rem] bg-brand-light/60 p-8 md:flex-row md:items-end md:justify-between md:p-12">
        <div class="max-w-2xl">
          <span class="eyebrow">Sob medida</span>
          <h2 class="mt-7 text-display-md font-bold text-neutral-ink">Não encontrou o que precisa?</h2>
          <p class="lede mt-5">Cada empreendimento é único. Fale com nossos especialistas para uma avaliação personalizada.</p>
        </div>
        <a href="/contato" class="btn-luxury shrink-0">
          Solicitar Proposta Técnica
          <svg class="arr h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
