---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE_CONFIG } from '../data/config.ts';

const whatsappUrl = `https://wa.me/${SITE_CONFIG.company.whatsapp}?text=${encodeURIComponent('Olá, vi o site no google e gostaria de mais informações!')}`;
const { address } = SITE_CONFIG.company;

const canais = [
  {
    k: 'Telefone / WhatsApp',
    v: SITE_CONFIG.company.phoneFormatted,
    href: `tel:${SITE_CONFIG.company.phone}`,
    icon: 'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z',
  },
  {
    k: 'E-mail',
    v: SITE_CONFIG.company.email,
    href: `mailto:${SITE_CONFIG.company.email}`,
    icon: 'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75',
  },
];
---

<Layout
  title="Contato e Orçamento de Consultoria Ambiental no RJ"
  description={`Entre em contato com a ${SITE_CONFIG.company.shortName}. Solicite uma proposta técnica e descubra como regularizar seu empreendimento com segurança jurídica.`}
>
  <Fragment slot="header"><Header /></Fragment>

  <PageHero eyebrow="Contato">
    <h1 class="rise rise-2 text-display-xl font-bold text-white">
      Entre em Contato <em class="text-accent-gold">para Licenciamento Ambiental</em>
    </h1>
    <h2 class="rise rise-3 mt-8 max-w-3xl text-[clamp(1.15rem,1.6vw,1.35rem)] font-semibold tracking-[-0.02em] leading-snug text-white/85">
      Solicite uma <span class="text-accent-gold">proposta técnica personalizada</span> e descubra como regularizar seu empreendimento
    </h2>
    <p class="rise rise-4 mt-7 max-w-2xl text-lg leading-relaxed text-white/60">
      Fale com nossa equipe de especialistas. Estamos prontos para conduzir seu projeto do diagnóstico à licença aprovada.
    </p>
  </PageHero>

  <section class="section-luxury bg-neutral-paper">
    <div class="section-inner">
      <h2 class="sr-only">Informações de Contato</h2>
      <div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-16">
        <!-- INFO -->
        <div class="reveal lg:col-span-5">
          <h3 class="eyebrow">Fale Conosco</h3>
          <p class="mt-7 text-display-sm font-semibold leading-snug text-neutral-ink">
            Diagnóstico sem compromisso. Você descreve o empreendimento, nós indicamos o caminho.
          </p>

          <ul class="mt-10">
            {canais.map((c) => (
              <li class="border-t border-neutral-line">
                <a href={c.href} class="group flex items-center gap-5 py-6">
                  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-light/70 text-brand-deep transition-colors group-hover:border-brand-deep group-hover:bg-brand-deep group-hover:text-accent-gold">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={c.icon} /></svg>
                  </span>
                  <span>
                    <span class="block text-[0.8rem] font-semibold text-neutral-ink-muted">{c.k}</span>
                    <span class="mt-1 block text-lg font-medium text-neutral-ink transition-colors group-hover:text-brand-mid">{c.v}</span>
                  </span>
                </a>
              </li>
            ))}
            <li class="border-t border-neutral-line">
              <a href={SITE_CONFIG.company.mapsUrl} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-5 py-6">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-light/70 text-brand-deep transition-colors group-hover:border-brand-deep group-hover:bg-brand-deep group-hover:text-accent-gold">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                </span>
                <span>
                  <span class="block text-[0.8rem] font-semibold text-neutral-ink-muted">Endereço</span>
                  <span class="mt-1 block leading-relaxed text-neutral-ink">{address.street} — {address.neighborhood}<br />{address.city} — {address.state}<br />CEP: {address.zipCode}</span>
                </span>
              </a>
            </li>
            <li class="border-y border-neutral-line">
              <div class="flex items-start gap-5 py-6">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-light/70 text-brand-deep">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </span>
                <span>
                  <span class="block text-[0.8rem] font-semibold text-neutral-ink-muted">Horário de Atendimento</span>
                  <span class="mt-1 block leading-relaxed text-neutral-ink">Segunda a Sexta: 08h às 18h<br />Sábado: 09h às 13h</span>
                </span>
              </div>
            </li>
          </ul>

          <div class="relative mt-10 overflow-hidden rounded-3xl bg-brand-deep p-8 text-white">
            <div class="topo text-white/[0.07]"></div>
            <div class="relative z-10 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h3 class="font-display text-[1.5rem] font-semibold">Prefere o WhatsApp?</h3>
                <p class="mt-1 text-sm text-white/55">Resposta rápida para dúvidas e solicitações de orçamento.</p>
              </div>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-luxury-gold shrink-0">
                <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                Abrir WhatsApp
              </a>
            </div>
          </div>
        </div>

        <!-- FORMULÁRIO -->
        <div class="reveal reveal-delay-1 lg:col-span-7">
          <div class="lg:sticky lg:top-28">
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
