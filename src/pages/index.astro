              <span class:list={['inline-flex h-11 w-11 items-center justify-center rounded-full transition-all duration-500 ease-out-expo group-hover:rotate-[-45deg]', i === 0 ? 'bg-accent-gold text-brand-night' : 'bg-white text-neutral-ink group-hover:bg-brand-deep group-hover:text-accent-gold']}>
