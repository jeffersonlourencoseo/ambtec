---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DiferencialCard from '../components/DiferencialCard.astro';
import CTABox from '../components/CTABox.astro';
import SchemaReview from '../components/SchemaReview.astro';
import SchemaFAQ from '../components/SchemaFAQ.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { SITE_CONFIG } from '../data/config.ts';

const faqs = [
  {
    question: 'O que faz uma consultoria ambiental?',
    answer: 'A consultoria ambiental ajuda empresas e empreendimentos a cumprir a legislação ambiental. Isso inclui enquadrar a atividade, elaborar estudos e projetos, obter e renovar licenças junto ao INEA e às prefeituras, responder a exigências e autuações e executar medidas como inventário florestal, supressão e poda autorizadas, compensação e reflorestamento.',
  },
  {
    question: 'Quem faz licenciamento ambiental no Rio de Janeiro?',
    answer: 'O pedido é do empreendedor, mas é conduzido por uma empresa de licenciamento ou consultoria ambiental com responsável técnico habilitado. O processo corre no INEA, na Secretaria Municipal de Meio Ambiente do município ou, quando aplicável, no IBAMA, conforme o porte e o impacto da atividade.',
  },
  {
    question: 'O que o INEA fiscaliza?',
    answer: 'O INEA é o órgão ambiental do estado do Rio de Janeiro. Licencia e fiscaliza atividades com potencial poluidor, cuida de unidades de conservação estaduais e dos recursos hídricos e controla a supressão de vegetação em sua competência. Prefeituras têm competência sobre atividades de impacto local.',
  },
  {
    question: 'Como escolher uma consultoria ambiental no Rio de Janeiro?',
    answer: 'Verifique se há responsável técnico habilitado e ART nos projetos, experiência com os processos do INEA e da prefeitura do seu município, proposta com escopo e cronograma claros e se a empresa consegue executar em campo o que a licença exige, sem depender de vários fornecedores.',
  },
  {
    question: 'Quanto custa uma consultoria ambiental?',
    answer: 'Não existe valor único. O custo depende do tipo de serviço, do porte da atividade, dos estudos exigidos e do órgão licenciador. Na Ambtec, a proposta é enviada depois de um diagnóstico, com escopo e cronograma definidos.',
  },
  {
    question: 'A Ambtec atende em todo o estado do Rio de Janeiro?',
    answer: 'Sim. Atendemos a capital, a Baixada Fluminense, a Região dos Lagos, a Serra e o interior do estado, com vistoria presencial quando necessário.',
  },
];

const whatsappUrl = `https://wa.me/${SITE_CONFIG.company.whatsapp}?text=${encodeURIComponent('Olá, vi o site no google e gostaria de mais informações!')}`;

const clientes = [
  'Honda', 'BMW', 'Chevrolet', 'Cedae', 'Atacadão', 'Megafor',
  'Royalty Barra Hotel', 'Construtora Vitale', 'Camil', 'GE Celma',
  'Atel Imóveis', 'Tecnosol', 'BRT',
];

const escopo = [
  { icon: 'M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z', html: '<a href="/servicos/licenciamento-ambiental" class="block text-[1.2rem] font-bold tracking-[-0.02em] text-neutral-ink hover:text-brand-mid">Licenciamento ambiental</a>LP, LI, LO, LAC e EIA/RIMA.' },
  { icon: 'm14.121 14.121 4.879 4.879M9.879 9.879 5 5m4.879 4.879a3 3 0 1 0 4.243 4.243 3 3 0 0 0-4.243-4.243Z', html: '<a href="/servicos/podas-e-supressao-vegetal" class="block text-[1.2rem] font-bold tracking-[-0.02em] text-neutral-ink hover:text-brand-mid">Supressão vegetal e poda</a> com laudo e autorização.' },
  { icon: 'm21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z', html: '<a href="/servicos/inventario-florestal-e-fauna" class="block text-[1.2rem] font-bold tracking-[-0.02em] text-neutral-ink hover:text-brand-mid">Inventário florestal</a> e levantamento de fauna.' },
  { icon: 'M12 21c4.97 0 9-3.582 9-8 0-5.5-9-11-9-11S3 7.5 3 13c0 4.418 4.03 8 9 8Zm0 0v-8', html: '<a href="/servicos/compensacao-ambiental" class="block text-[1.2rem] font-bold tracking-[-0.02em] text-neutral-ink hover:text-brand-mid">Compensação ambiental</a> e <a href="/servicos/reflorestamento" class="font-semibold text-neutral-ink link-u">reflorestamento</a>.' },
];

const diferenciais = [
  { t: 'Diagnóstico Técnico Especializado', d: 'Após o primeiro contato, nossa equipe técnica analisa as particularidades do seu empreendimento e apresenta uma proposta detalhada com cronograma realista.', icon: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z' },
  { t: 'Equipe Multidisciplinar', d: 'Engenheiros ambientais e biólogos especialistas trabalhando integrados para uma solução completa e segura, cobrindo todos os aspectos técnicos do licenciamento.', icon: 'M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z' },
  { t: 'Tudo para Licenciar em um Só Lugar', d: 'Do laudo ao plantio, do inventário à compensação. Nossa equipe integra licenciamento, estudos técnicos e execução prática — sem atrasos causados por fornecedores separados.', icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z' },
  { t: 'Atendimento em Todo o Estado', d: 'Onde seu empreendimento estiver, nossa equipe vai até você. Atendimento presencial e remoto flexível, adaptado às necessidades do projeto.', icon: 'M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z' },
];

const servicosHome = [
  { href: '/servicos/licenciamento-ambiental', t: 'Licenciamento Ambiental', d: 'LP, LI, LO, EIA/RIMA e protocolo junto ao INEA e prefeituras.', icon: 'M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z' },
  { href: '/servicos/compensacao-ambiental', t: 'Compensação Ambiental', d: 'Plano, cálculo e execução de ações compensatórias exigidas na licença.', icon: 'M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0 0 12 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 0 1-2.031.352 5.988 5.988 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971Zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 0 1-2.031.352 5.989 5.989 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971Z' },
  { href: '/servicos/inventario-florestal-e-fauna', t: 'Inventário Florestal e Fauna', d: 'Levantamento científico que subsidia o licenciamento e a compensação.', icon: 'm21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z' },
  { href: '/servicos/podas-e-supressao-vegetal', t: 'Podas e Supressão Vegetal', d: 'Laudo, autorização e execução de cortes legais para obras licenciadas.', icon: 'm14.121 14.121 4.879 4.879M9.879 9.879 5 5m4.879 4.879a3 3 0 1 0 4.243 4.243 3 3 0 0 0-4.243-4.243Z' },
  { href: '/servicos/reflorestamento', t: 'Reflorestamento e Recuperação', d: 'Plantio de espécies nativas e monitoramento de áreas recuperadas.', icon: 'M12 21c4.97 0 9-3.582 9-8 0-5.5-9-11-9-11S3 7.5 3 13c0 4.418 4.03 8 9 8Zm0 0v-8' },
];

---

<Layout
  title={SITE_CONFIG.seo.defaultTitle}
  description="Consultoria ambiental no Rio de Janeiro: licenciamento junto ao INEA e prefeituras, supressão vegetal, inventário florestal, compensação e reflorestamento com a mesma equipe técnica. Diagnóstico gratuito."
>
  <Fragment slot="header"><Header /></Fragment>

  <SchemaFAQ questions={faqs} />

  <SchemaReview
    itemReviewed={SITE_CONFIG.company.name}
    reviews={SITE_CONFIG.google.reviews.map((r) => ({ author: r.nome, reviewBody: r.texto, reviewRating: 5, datePublished: '2026-04' }))}
  />


  <!-- HERO -->
  <section class="panel-dark mt-2 sm:mt-3" data-hero-dark>
    <img
      src="/images/hero-ambiental.webp"
      alt="Vista aérea de floresta tropical e vegetação nativa no Rio de Janeiro"
      fetchpriority="high"
      decoding="async"
      class="hero-zoom absolute inset-0 h-full w-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-[linear-gradient(105deg,rgba(5,34,26,0.96)_0%,rgba(5,34,26,0.85)_45%,rgba(10,51,38,0.35)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-brand-night/90 to-transparent"></div>
    <div class="glow -left-32 top-1/3 h-96 w-96 bg-accent-gold/10"></div>

    <div class="wrap relative z-10 pb-8 pt-[calc(var(--header-h)+3rem)] md:pb-10 md:pt-[calc(var(--header-h)+4.5rem)]">
      <div class="grid items-center gap-14 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <span class="rise rise-1 eyebrow eyebrow-light">Referência em Consultoria Ambiental no Rio</span>

          <h1 class="rise rise-2 mt-7 font-display text-display-xl font-bold text-white">
            Consultoria Ambiental<br /> <em class="text-accent-gold">no Rio de Janeiro</em>
          </h1>

          <h2 class="rise rise-3 mt-6 max-w-xl text-[clamp(1.15rem,1.6vw,1.35rem)] font-semibold leading-snug tracking-[-0.02em] text-white/90">
            Licenciamento ambiental junto ao <span class="text-accent-gold">INEA</span> e Secretarias Municipais de Meio Ambiente
          </h2>

          <p class="rise rise-4 mt-5 max-w-[38rem] text-[1rem] leading-relaxed text-white/60">
            Empresa de consultoria ambiental e <a href="/servicos/licenciamento-ambiental" class="text-white underline decoration-accent-gold/70 underline-offset-4">licenciamento ambiental</a> para empresas no Rio de Janeiro. <strong class="font-semibold text-white/90">Uma única equipe técnica</strong> cuida do licenciamento junto ao INEA e das Secretarias Municipais <span class="text-white/80">— e executa no terreno tudo o que for necessário:</span> compensação ambiental, inventário florestal, podas legalizadas e reflorestamento. Sem fornecedores terceirizados, sem descasamento técnico.
          </p>

          <div class="rise rise-5 mt-9 flex flex-wrap items-center gap-3">
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-luxury-gold !pr-2">
              Solicitar Orçamento
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-brand-night text-accent-gold">
                <svg class="arr h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M8 7h9v9" /></svg>
              </span>
            </a>
            <a href="/servicos" class="btn-luxury-dark">Conhecer Serviços</a>
          </div>
        </div>

        <!-- Cartões flutuantes -->
        <div class="relative hidden lg:col-span-5 lg:block" aria-hidden="true">
          <div class="rise rise-3 ml-auto w-[22rem]"><div class="float-y relative rounded-[1.75rem] bg-white p-6 text-neutral-ink shadow-dramatic">
            <div class="flex items-center justify-between">
              <span class="chip">Do diagnóstico à licença</span>
              <span class="text-xs font-semibold text-neutral-ink-muted">INEA · SMAC</span>
            </div>
            <p class="mt-5 text-[1.15rem] font-bold tracking-tight">Licença de Operação</p>
            <ul class="mt-5 space-y-3.5">
              {['Diagnóstico técnico', 'Estudos e protocolo', 'Resposta às exigências', 'Licença emitida'].map((s, i) => (
                <li class="flex items-center gap-3">
                  <span class:list={['flex h-6 w-6 shrink-0 items-center justify-center rounded-full', i < 3 ? 'bg-brand-deep text-accent-gold' : 'bg-accent-gold text-brand-night']}>
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                  </span>
                  <span class:list={['text-[0.92rem]', i === 3 ? 'font-bold' : 'font-medium text-neutral-ink-muted']}>{s}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 h-2 overflow-hidden rounded-full bg-neutral-cream">
              <div class="h-full w-full rounded-full bg-gradient-to-r from-brand-mid to-accent-gold"></div>
            </div>
          </div></div>

          <div class="rise rise-4 absolute -top-20 left-2 w-52 rotate-[-4deg] rounded-[1.5rem] bg-accent-gold p-5 text-brand-night shadow-dramatic">
            <p class="text-[2.6rem] font-bold leading-none tracking-[-0.05em]">98%</p>
            <p class="mt-2 text-sm font-semibold leading-snug">de aprovação na primeira submissão</p>
          </div>
        </div>
      </div>

      <!-- Números -->
      <dl class="rise rise-5 mt-16 grid grid-cols-2 gap-2 md:mt-20 lg:grid-cols-4">
        {[
          { v: '200+', l: 'Empreendimentos Regularizados' },
          { v: '98%', l: 'Taxa de Aprovação' },
          { v: '15+', l: 'Anos de Experiência' },
          { v: '5', l: 'Especialidades Técnicas' },
        ].map((s) => (
          <div class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.06] px-5 py-5 backdrop-blur-md md:px-6">
            <dd class="text-[2rem] font-bold leading-none tracking-[-0.05em] text-white md:text-[2.4rem]">{s.v}</dd>
            <dt class="mt-2 text-[0.82rem] font-medium leading-snug text-white/55">{s.l}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- CLIENTES -->
  <section class="px-5 pb-6 pt-16 sm:px-8 md:pt-20 lg:px-12">
    <div class="mx-auto max-w-site">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="text-[clamp(1.4rem,2.2vw,1.9rem)] font-bold text-neutral-ink">Empresas que confiam na <em class="text-brand-mid">{SITE_CONFIG.company.shortName}</em></h2>
        <p class="mt-3 text-neutral-ink-muted">Atuamos junto a grandes indústrias, construtoras, redes varejistas, concessionárias e empreendimentos hoteleiros no Rio de Janeiro.</p>
      </div>
      <div class="marquee reveal mt-10 overflow-hidden">
        <ul class="marquee-track gap-3">
          {[...clientes, ...clientes].map((c, i) => (
            <li aria-hidden={i >= clientes.length ? 'true' : undefined} class="flex h-16 shrink-0 items-center rounded-2xl border border-neutral-line bg-white px-7 text-[1.05rem] font-bold tracking-[-0.02em] text-neutral-ink/60">
              {c}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- DEFINIÇÃO -->
  <section class="section-luxury">
    <div class="section-inner">
      <div class="reveal relative overflow-hidden rounded-[2rem] bg-brand-light/60 p-8 sm:p-12 lg:p-16">
        <div class="topo text-brand-deep/[0.06]"></div>
        <div class="relative grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <span class="eyebrow">Definição</span>
            <h2 class="mt-6 text-display-md font-bold text-neutral-ink">
              O que é <em class="text-brand-mid">Licenciamento Ambiental</em> no Rio de Janeiro?
            </h2>
          </div>
          <div class="lg:col-span-7">
            <p class="text-[clamp(1.15rem,1.7vw,1.4rem)] font-medium leading-[1.6] tracking-[-0.01em] text-neutral-ink">
              O <strong class="font-bold">licenciamento ambiental no Rio de Janeiro</strong> é o processo obrigatório de autorização junto ao INEA e Secretarias Municipais para instalar, ampliar ou operar empreendimentos impactantes. Garante conformidade legal, protege ecossistemas como a Mata Atlântica e evita multas milionárias a empresas.
            </p>
            <div class="mt-8 flex flex-wrap gap-2">
              {['INEA', 'Secretarias Municipais', 'Mata Atlântica', 'Conformidade legal'].map((t) => (
                <span class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-brand-deep">{t}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- O QUE FAZ UMA CONSULTORIA -->
  <section class="section-luxury !pt-0">
    <div class="section-inner">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="reveal lg:col-span-5">
          <span class="eyebrow">Escopo</span>
          <h2 class="mt-6 text-display-lg font-bold text-neutral-ink">
            O que faz uma <em class="text-brand-mid">consultoria ambiental</em>?
          </h2>
          <p class="lede mt-6">
            A consultoria ambiental cuida da conformidade legal da sua empresa: enquadra a atividade, elabora estudos e projetos, obtém e renova licenças, responde a exigências e autuações e executa em campo o que a licença pede.
          </p>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
          {escopo.map((e, i) => (
            <li class={`reveal reveal-delay-${i + 1} card card-hover flex flex-col p-7`}>
              <span class="icon-tile">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={e.icon} /></svg>
              </span>
              <p class="mt-6 leading-relaxed text-neutral-ink-muted" set:html={e.html} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="section-luxury bg-white">
    <div class="section-inner">
      <div class="reveal mx-auto max-w-2xl text-center">
        <span class="eyebrow">Método</span>
        <h2 class="mt-6 text-display-lg font-bold text-neutral-ink">Como funciona o nosso trabalho</h2>
        <p class="lede mt-5">Quatro etapas, uma equipe do começo ao fim.</p>
      </div>

      <ol class="mt-14 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
        {[
          { n: '1', t: 'Diagnóstico', d: 'Analisamos o empreendimento, a documentação e o enquadramento junto ao INEA ou à prefeitura.' },
          { n: '2', t: 'Proposta', d: 'Escopo, cronograma e valor definidos antes de começar.' },
          { n: '3', t: 'Protocolo e acompanhamento', d: 'Estudos, protocolo e resposta técnica às exigências até a emissão da licença.' },
          { n: '4', t: 'Execução e pós-licença', d: 'Inventário, supressão, compensação e reflorestamento, mais condicionantes e renovação.' },
        ].map((p, i) => (
          <li class={`reveal reveal-delay-${i + 1} group relative overflow-hidden rounded-3xl bg-neutral-paper p-7 transition-colors duration-500 hover:bg-brand-deep`}>
            <div class="flex items-center justify-between">
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-accent-gold text-lg font-bold text-brand-night">{p.n}</span>
              <span class="text-sm font-semibold text-neutral-ink-muted transition-colors group-hover:text-white/40">Etapa {p.n}/4</span>
            </div>
            <h3 class="mt-10 text-[1.35rem] font-bold leading-tight text-neutral-ink transition-colors group-hover:text-white">{p.t}</h3>
            <p class="mt-3 leading-relaxed text-neutral-ink-muted transition-colors group-hover:text-white/60">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- DIFERENCIAIS -->
  <section class="panel-dark py-20 md:py-28">
    <div class="topo text-white/[0.04]"></div>
    <div class="glow -right-20 -top-20 h-96 w-96 bg-accent-gold/10"></div>
    <div class="wrap relative z-10">
      <div class="reveal grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <span class="eyebrow eyebrow-light">Diferenciais</span>
          <h2 class="mt-6 text-display-lg font-bold text-white">
            Por que empresas confiam na <em class="text-accent-gold">{SITE_CONFIG.company.shortName}</em>?
          </h2>
        </div>
        <p class="text-lg leading-relaxed text-white/60 lg:col-span-5">Técnica integrada que vai do licenciamento à execução prática no terreno. Uma equipe, um cronograma, uma responsabilidade.</p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
        {diferenciais.map((d, i) => (
          <div class={`reveal reveal-delay-${i + 1}`}>
            <DiferencialCard tone="dark" index={i + 1} title={d.t} description={d.d} icon={d.icon} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SOBRE NÓS (RESUMO) -->
  <section class="section-luxury">
    <div class="section-inner">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="reveal relative lg:col-span-5">
