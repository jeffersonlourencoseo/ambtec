              <p class:list={['mt-3 max-w-md leading-relaxed', i === 0 ? 'text-white/65' : 'text-neutral-ink-muted']}>{s.d}</p>
            </div>
          </a>
        ))}
        <div class="reveal flex flex-col justify-between gap-6 rounded-[1.75rem] bg-accent-gold p-7 text-brand-night md:col-span-2 md:p-8 lg:col-span-3 lg:flex-row lg:items-center lg:gap-12 lg:px-10">
