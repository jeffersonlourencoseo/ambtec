---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../data/config.ts';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const [destaque, ...demais] = posts;
const fmt = (d: Date, month: 'short' | 'long' = 'short') => d.toLocaleDateString('pt-BR', { day: 'numeric', month, year: 'numeric' });
---

<Layout
  title="Blog de Licenciamento Ambiental no Rio de Janeiro"
  description="Guias e artigos sobre licenciamento ambiental no RJ: custo, tipos de licença, INEA, supressão vegetal, poda de árvores, CAR e legislação atualizada."
>
  <Fragment slot="header"><Header /></Fragment>

  <PageHero eyebrow="Blog · Conteúdo técnico">
    <h1 class="rise rise-2 text-display-xl font-bold text-white">
      Blog sobre <em class="text-accent-gold">Licenciamento Ambiental</em> no Rio de Janeiro
    </h1>
    <p class="rise rise-3 mt-8 max-w-2xl text-lg leading-relaxed text-white/60 md:text-xl">
      Conteúdo técnico para decisões inteligentes. Artigos sobre licenciamento, CAR, avaliação de impacto e gestão ambiental.
    </p>
  </PageHero>

  <section class="section-luxury bg-neutral-paper">
    <div class="section-inner">
      <h2 class="sr-only">Últimos Artigos sobre Licenciamento Ambiental</h2>

      {destaque && (
        <a href={`/blog/${destaque.slug}`} class="reveal group relative block overflow-hidden rounded-[1.75rem] bg-brand-deep text-white">
          <img src="/images/hero-ambiental.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-30" />
          <div class="absolute inset-0 bg-gradient-to-r from-brand-night via-brand-night/85 to-brand-night/30"></div>
          <div class="topo text-white/[0.06] transition-transform duration-[1.2s] ease-out-expo group-hover:scale-105"></div>
          <div class="relative z-10 grid gap-10 p-8 sm:p-12 lg:grid-cols-12 lg:items-end lg:p-16">
            <div class="lg:col-span-8">
              <div class="flex flex-wrap items-center gap-3 text-[0.8rem] font-semibold">
                <span class="rounded-full bg-accent-gold px-3 py-1 text-brand-night">Mais recente</span>
                <span class="text-white/55">{fmt(destaque.data.pubDate, 'long')}</span>
              </div>
              <h3 class="mt-7 text-display-md font-bold text-white">{destaque.data.title}</h3>
              <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/60">{destaque.data.description}</p>
            </div>
            <div class="lg:col-span-4 lg:flex lg:justify-end">
              <span class="btn-luxury-gold">
                Ler artigo
                <svg class="arr h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
              </span>
            </div>
          </div>
        </a>
      )}

      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {demais.map((post) => (
          <a href={`/blog/${post.slug}`} class="reveal group flex h-full flex-col rounded-[1.75rem] border border-neutral-line bg-white p-3 pb-7 transition-all duration-500 ease-out-expo hover:-translate-y-1 hover:border-brand-mid/25 hover:bg-white hover:shadow-lift">
            <article class="flex h-full flex-col">
              <div class="relative mb-6 h-36 overflow-hidden rounded-[1.25rem] bg-brand-deep">
                <div class="topo text-white/[0.12] transition-transform duration-[1.2s] ease-out-expo group-hover:scale-110"></div>
                <div class="glow -right-10 -top-10 h-40 w-40 bg-accent-gold/25"></div>
                {post.data.tags?.[0] && <span class="absolute bottom-4 left-4 rounded-full bg-white/90 px-3 py-1 text-xs font-bold capitalize text-brand-deep backdrop-blur">{post.data.tags[0]}</span>}
              </div>
              <div class="flex flex-1 flex-col px-4">
              <span class="text-[0.8rem] font-semibold text-accent-gold-deep">{fmt(post.data.pubDate)}</span>
              <h3 class="mt-5 font-display text-[1.45rem] font-semibold leading-snug text-neutral-ink transition-colors duration-300 group-hover:text-brand-mid">{post.data.title}</h3>
              <p class="mt-4 flex-1 leading-relaxed text-neutral-ink-muted line-clamp-4">{post.data.description}</p>
              <span class="mt-8 inline-flex items-center gap-2 border-t border-neutral-line pt-5 text-sm font-semibold text-neutral-ink">
                Ler artigo
                <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
              </span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
