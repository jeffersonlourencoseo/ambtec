---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CTABox from '../components/CTABox.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { SITE_CONFIG } from '../data/config.ts';

const r = SITE_CONFIG.responsavel;
const whatsappUrl = `https://wa.me/${SITE_CONFIG.company.whatsapp}?text=${encodeURIComponent(`Olá, vi o site no google e gostaria de falar com ${r.nome.split(' ')[0]}.`)}`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: r.nome,
  jobTitle: r.cargo,
  worksFor: { '@type': 'Organization', name: SITE_CONFIG.company.name, url: SITE_CONFIG.site },
  hasCredential: [
    { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Registro profissional', name: r.registro },
    { '@type': 'EducationalOccupationalCredential', credentialCategory: 'degree', name: 'Graduação e Licenciatura em Ciências Biológicas', recognizedBy: { '@type': 'CollegeOrUniversity', name: 'Universidade da Cidade' } },
    { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Pós-graduação', name: 'Gestão de Recursos Hídricos e Auditoria Ambiental', recognizedBy: { '@type': 'CollegeOrUniversity', name: 'Universidade Federal do Rio de Janeiro' } },
  ],
  knowsAbout: ['Licenciamento ambiental', 'Inventário florestal', 'Recursos hídricos', 'Auditoria ambiental'],
  url: SITE_CONFIG.site + '/sobre#responsavel',
};

const equipe = [
  { t: 'Engenheiros ambientais', d: 'Enquadramento, estudos ambientais, protocolo e resposta às exigências dos órgãos.', icon: 'M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085' },
  { t: 'Biólogos', d: 'Inventário florestal e de fauna, laudos de vegetação e projetos de compensação.', icon: 'M12 21c4.97 0 9-3.582 9-8 0-5.5-9-11-9-11S3 7.5 3 13c0 4.418 4.03 8 9 8Zm0 0v-8' },
  { t: 'Geoprocessadores', d: 'Mapas, georreferenciamento e análise de uso do solo para os estudos e o CAR.', icon: 'M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z' },
  { t: 'Equipe de campo', d: 'Execução de podas, supressão autorizada, plantio e monitoramento das áreas.', icon: 'M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z' },
];

const valores = [
  {
    t: 'Missão', icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z', icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
    d: 'Simplificar a conformidade ambiental para que empresas e empreendimentos possam crescer com segurança jurídica e responsabilidade socioambiental.',
  },
  {
    t: 'Visão', icon: 'M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178zM15 12a3 3 0 11-6 0 3 3 0 016 0z', icon: 'M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178zM15 12a3 3 0 11-6 0 3 3 0 016 0z',
    d: 'Ser reconhecida como a consultoria ambiental mais confiável e eficiente do estado, referência em licenciamento rápido e gestão sustentável.',
  },
  {
    t: 'Valores', icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z', icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z',
    d: 'Transparência, excelência técnica, compromisso com prazos, sustentabilidade e atendimento humanizado em cada projeto.',
  },
];

const escopo = [
  { b: 'Licenciamento Ambiental', d: 'LP, LI e LO no INEA e Secretarias Municipais' },
  { b: 'Compensação Ambiental', d: 'planejamento, execução e regularização junto aos órgãos' },
  { b: 'Inventário Florestal e de Fauna', d: 'levantamento científico para licenciamento' },
  { b: 'Podas e Supressão Vegetal', d: 'laudo técnico, autorização e execução legalizada' },
  { b: 'Reflorestamento e Recuperação', d: 'plantio de espécies nativas e monitoramento' },
  { b: 'EIA/RIMA', d: 'renovação de licenças e defesa técnica em processos administrativos' },
];

const setores = [
  { t: 'Indústria e Galpões', icon: 'M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21', d: 'Indústrias de pequeno, médio e grande porte, galpões logísticos, usinas de asfalto e centrais de processamento. Licenciamento ambiental no INEA ou municipal conforme a atividade.' },
  { t: 'Construção Civil e Loteamentos', icon: 'M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21', d: 'Construtoras, incorporadoras, loteamentos urbanos, condomínios residenciais e comerciais. Regularização junto à Secretaria Municipal de Meio Ambiente e INEA.' },
  { t: 'Hotéis e Turismo', icon: 'M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z', d: 'Hotéis, pousadas, resorts, marinas e empreendimentos turísticos em áreas costeiras e de Mata Atlântica. Licenciamento específico para uso em áreas sensíveis.' },
  { t: 'Comércio e Shoppings', icon: 'M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007Z', d: 'Grandes superfícies comerciais, shoppings centers, hipermercados, postos de combustível e centros de distribuição. Alvará ambiental e licença de operação.' },
  { t: 'Infraestrutura e Obras', icon: 'M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085', d: 'Rodovias, túneis, sistemas de drenagem, obras de saneamento, dragagem e recuperação de áreas degradadas. EIA/RIMA e licenças junto ao INEA.' },
  { t: 'Energia e Telecom', icon: 'm3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z', d: 'Subestações, linhas de transmissão, torres de telecomunicações, usinas de energia solar e eólica. Estudos ambientais e licenciamento junto ao INEA e órgãos municipais.' },
];
---

<Layout
  title={`Sobre a ${SITE_CONFIG.company.shortName} — Quem Somos e Nossa História`}
  description={`Conheça a ${SITE_CONFIG.company.name}: consultoria ambiental no RJ que integra licenciamento junto ao INEA e prefeituras com execução técnica no terreno. Tudo em um só lugar.`}
>
  <Fragment slot="header"><Header /></Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <!-- HERO -->
  <PageHero eyebrow="Quem somos" image>
    <h1 class="rise rise-2 text-display-xl font-bold text-white">
      Quem somos: <em class="text-accent-gold">Ambtec Consultoria Ambiental</em>
    </h1>
    <h2 class="rise rise-3 mt-8 max-w-3xl text-[clamp(1.15rem,1.6vw,1.35rem)] font-semibold tracking-[-0.02em] leading-snug text-white/85">
      Mais de <span class="text-accent-gold">200 empreendimentos regularizados</span> junto ao INEA e prefeituras fluminenses
    </h2>
    <p class="rise rise-4 mt-7 max-w-2xl text-lg leading-relaxed text-white/60">
      Consultoria ambiental no Rio de Janeiro especializada em licenciamento junto ao INEA e Secretarias Municipais de Meio Ambiente. Mais de 15 anos regularizando indústrias, construtoras, empreendimentos imobiliários e comércios.
    </p>
  </PageHero>

  <!-- RESPONSÁVEL -->
  <section class="relative bg-neutral-paper px-5 pb-24 pt-20 sm:px-8 md:pb-32 md:pt-28 lg:px-12" id="responsavel">
    <div class="mx-auto grid max-w-site grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-20">
      <!-- Ficha técnica -->
      <div class="reveal lg:col-span-5">
        <aside class="relative overflow-hidden rounded-3xl bg-brand-deep text-white lg:sticky lg:top-32" aria-label={`Ficha técnica de ${r.nome}`}>
          <div class="topo text-white/[0.08]"></div>
          <div class="relative z-10 p-7 sm:p-10">
            <p class="text-[0.8rem] font-semibold text-white/50">Registro profissional</p>
            <p class="mt-3 font-display text-[clamp(1.9rem,3.2vw,2.5rem)] font-semibold leading-tight tracking-tight text-accent-gold">{r.registro}</p>

            <h3 class="mt-9 border-t border-white/15 pt-7 text-[0.8rem] font-semibold text-white/50">Formação</h3>
            <ul class="mt-5 space-y-5">
              {r.formacoes.map((f) => (
                <li>
                  <p class="font-semibold leading-snug text-white">{f.curso}</p>
                  <p class="mt-1 text-sm leading-relaxed text-white/60">{f.instituicao}</p>
                </li>
              ))}
            </ul>

            <h3 class="mt-9 border-t border-white/15 pt-7 text-[0.8rem] font-semibold text-white/50">Responde pela Ambtec em</h3>
            <ul class="mt-5 flex flex-wrap gap-2">
              {r.atribuicoes.map((a) => (
                <li class="rounded-full border border-white/15 bg-white/[0.05] px-4 py-2 text-sm font-medium text-white/85">{a}</li>
              ))}
            </ul>

            <p class="mt-9 flex items-center justify-between gap-4 border-t border-white/15 pt-6 text-[0.8rem] font-semibold">
              <span class="text-white/60">INEA e prefeituras</span>
              <span class="text-accent-gold">Guaratiba · RJ</span>
            </p>
          </div>
        </aside>
      </div>

      <!-- Apresentação -->
      <div class="reveal reveal-delay-1 lg:col-span-7 lg:pt-6">
        <span class="eyebrow"><span class="idx">01</span> Responsável pela empresa</span>
        <h2 class="mt-7 text-display-lg font-bold text-neutral-ink">{r.nome}</h2>
        <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-lg text-neutral-ink-muted">
          <span class="font-medium text-neutral-ink">{r.cargo}</span>
          <span class="h-1 w-1 rounded-full bg-accent-gold" aria-hidden="true"></span>
          <span>{r.formacao}</span>
        </p>

        <blockquote class="relative mt-12 border-t border-neutral-line pt-10">
          <svg class="absolute -top-4 left-0 h-8 w-8 bg-neutral-paper pr-2 text-accent-gold" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M9.3 25.6c-2.6 0-4.6-2-4.6-5 0-4.6 3.3-9.4 8-12.1l1.4 1.8c-2.7 1.9-4.3 4.1-4.6 6.5h.6c2.4 0 4.2 1.7 4.2 4.2 0 2.6-2.1 4.6-5 4.6zm13.4 0c-2.6 0-4.6-2-4.6-5 0-4.6 3.3-9.4 8-12.1l1.4 1.8c-2.7 1.9-4.3 4.1-4.6 6.5h.6c2.4 0 4.2 1.7 4.2 4.2 0 2.6-2.1 4.6-5 4.6z"/></svg>
          <p class="font-serif text-[clamp(1.4rem,2.3vw,1.9rem)] font-semibold italic leading-[1.4] text-neutral-ink">{r.citacao}</p>
        </blockquote>

        <div class="mt-12 space-y-6 text-lg leading-relaxed text-neutral-ink-muted">
          {r.bio.map((p) => <p>{p}</p>)}
        </div>

        <dl class="mt-12 grid grid-cols-1 border-y border-neutral-line sm:grid-cols-3">
          {r.destaques.map((d, i) => (
            <div class:list={['flex items-center justify-between gap-6 py-5 sm:flex-col sm:items-start sm:justify-start sm:gap-0 sm:py-7', i > 0 && 'border-t border-neutral-line sm:border-l sm:border-t-0 sm:pl-8']}>
              <dd class="order-2 font-display text-[2.2rem] font-semibold leading-none tracking-tight text-brand-deep sm:order-none sm:text-[clamp(2rem,3.4vw,2.8rem)]">{d.valor}</dd>
              <dt class="text-sm leading-snug text-neutral-ink-muted sm:mt-3">{d.rotulo}</dt>
            </div>
          ))}
        </dl>

        <div class="mt-12 flex flex-wrap gap-3">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-luxury">
            Falar com {r.nome.split(' ')[0]}
            <svg class="arr h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
          </a>
          {r.linkedin && (
            <a href={r.linkedin} target="_blank" rel="noopener noreferrer" class="btn-luxury-outline">LinkedIn</a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- EQUIPE -->
  <section class="section-luxury !pt-0">
    <div class="section-inner">
      <div class="reveal rounded-[2rem] bg-brand-light/60 p-8 sm:p-12">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-6">
            <span class="eyebrow">Equipe técnica</span>
            <h2 class="mt-6 text-display-md font-bold text-neutral-ink">Uma equipe <em class="text-brand-mid">multidisciplinar</em> sob a mesma coordenação</h2>
          </div>
          <p class="lede lg:col-span-6">Sob a coordenação do responsável técnico, profissionais de diferentes áreas trabalham integrados em cada projeto, do estudo ao plantio, do laudo ao protocolo.</p>
        </div>
        <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {equipe.map((e) => (
            <div class="rounded-3xl bg-white p-6">
              <span class="icon-tile">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={e.icon} /></svg>
              </span>
              <h3 class="mt-6 text-[1.15rem] font-bold tracking-[-0.02em] text-neutral-ink">{e.t}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-neutral-ink-muted">{e.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- HISTÓRIA -->
  <section class="section-luxury bg-neutral-cream">
    <div class="section-inner">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-12 lg:gap-20">
        <div class="reveal lg:col-span-7">
          <span class="eyebrow"><span class="idx">02</span> Nossa história</span>
          <p class="mt-8 text-display-sm font-semibold leading-snug text-neutral-ink">
            A {SITE_CONFIG.company.shortName} nasceu de uma constatação simples: <em class="text-brand-mid">a burocracia ambiental estava matando bons empreendimentos</em>.
          </p>
          <div class="mt-10 space-y-6 text-lg leading-relaxed text-neutral-ink-muted">
            <p>
              Empresários e gestores de projetos perdiam meses — às vezes anos — tentando entender sozinhos um sistema que deveria ser acessível, mas era injustamente complexo. Fundada em 2010 por um grupo de engenheiros ambientais e biólogos especialistas, a {SITE_CONFIG.company.shortName} começou como uma pequena consultoria local.
            </p>
            <p>
              Hoje, <strong class="font-semibold text-neutral-ink">já são mais de 200 empreendimentos regularizados</strong> e uma equipe multidisciplinar que atua em todo o estado do Rio de Janeiro.
            </p>
            <p>
              Nosso diferencial nunca foi apenas o conhecimento técnico — embora tenhamos isso de sobra. O que nos destaca é o <strong class="font-semibold text-neutral-ink">compromisso de traduzir a linguagem burocrática em ações claras</strong>, acompanhando cada cliente da primeira conversa até a licença aprovada.
            </p>
          </div>
        </div>

        <aside class="reveal reveal-delay-2 lg:col-span-5">
          <div class="relative overflow-hidden rounded-3xl bg-brand-deep p-8 text-white sm:p-10 lg:sticky lg:top-32">
            <div class="topo text-white/[0.06]"></div>
            <div class="relative z-10">
              <div class="flex items-center justify-between border-b border-white/15 pb-5">
                <h3 class="text-[0.8rem] font-semibold text-white/50">Números que contam</h3>
                <span class="text-[0.8rem] font-semibold text-accent-gold">2010 → hoje</span>
              </div>
              <dl>
                {[
                  { v: '200+', l: 'Empreendimentos Regularizados', s: 'Desde 2010' },
                  { v: '98%', l: 'Taxa de Aprovação', s: 'Na primeira submissão' },
                  { v: '15+', l: 'Anos de Experiência', s: 'No mercado fluminense' },
                ].map((x) => (
                  <div class="flex items-end justify-between gap-6 border-b border-white/10 py-6 last:border-0 last:pb-0">
                    <div>
                      <dt class="font-semibold text-white">{x.l}</dt>
                      <dd class="mt-1 text-sm text-white/50">{x.s}</dd>
                    </div>
                    <dd class="font-display text-[2.6rem] font-semibold leading-none tracking-tight text-accent-gold">{x.v}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- MISSÃO, VISÃO E VALORES -->
  <section class="section-luxury bg-neutral-paper">
    <div class="section-inner">
      <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <span class="eyebrow"><span class="idx">03</span> Princípios</span>
          <h2 class="mt-7 text-display-lg font-bold text-neutral-ink">Missão, Visão e Valores</h2>
        </div>
        <p class="lede md:text-right">O que nos move todos os dias.</p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-4 md:grid-cols-3">
        {valores.map((v, i) => (
          <div class:list={[`reveal reveal-delay-${i + 1} flex flex-col rounded-[1.75rem] p-8 transition-transform duration-500 ease-out-expo hover:-translate-y-1`, i === 0 ? 'bg-brand-deep text-white' : 'card']}>
            <span class={i === 0 ? 'icon-tile-dark' : 'icon-tile'}>
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={v.icon} /></svg>
            </span>
            <h3 class:list={['mt-12 text-[1.75rem] font-bold tracking-[-0.03em]', i === 0 ? 'text-white' : 'text-neutral-ink']}>{v.t}</h3>
            <p class:list={['mt-3 text-lg leading-relaxed', i === 0 ? 'text-white/65' : 'text-neutral-ink-muted']}>{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DO LICENCIAMENTO À EXECUÇÃO -->
  <section class="panel-dark py-20 md:py-28">
    <div class="topo text-white/[0.045]"></div>
    <div class="noise-overlay absolute inset-0"></div>
    <div class="wrap relative z-10">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-12 lg:gap-20">
        <div class="reveal lg:col-span-6">
          <span class="eyebrow eyebrow-light"><span class="idx">04</span> Integração</span>
          <h2 class="mt-7 text-display-lg font-bold text-white">
            Do licenciamento à <em class="text-accent-gold">execução técnica</em>
          </h2>
          <div class="mt-9 space-y-6 text-lg leading-relaxed text-white/60">
            <p>
              O <strong class="font-semibold text-white">licenciamento ambiental</strong> é o ponto de partida, mas raramente é o único serviço necessário. Para aprovar uma licença no INEA ou na Secretaria Municipal de Meio Ambiente, seu empreendimento pode precisar realizar <strong class="font-semibold text-white">compensação ambiental</strong>, fazer um <strong class="font-semibold text-white">inventário florestal e de fauna</strong>, executar <strong class="font-semibold text-white">podas e supressão vegetal legalizada</strong>, ou implantar um projeto de <strong class="font-semibold text-white">reflorestamento e recuperação de áreas degradadas</strong>.
            </p>
            <p>
              Na Ambtec, esses serviços não são isolados. Eles se interligam. Nossa equipe técnica — <strong class="font-semibold text-white">engenheiros ambientais, biólogos e geoprocessadores</strong> — trabalha de forma integrada para que cada etapa, do estudo ao plantio, do laudo ao protocolo, converse com a próxima. Isso elimina retrabalho, reduz prazos e garante que a documentação entregue aos órgãos ambientais tenha <strong class="font-semibold text-white">coerência técnica e legal</strong>.
            </p>
            <p>
              Atuamos com <strong class="font-semibold text-white">indústrias, construtoras, empreendimentos imobiliários, comércios, hotéis, loteamentos, shoppings e infraestrutura</strong> em todo o estado do Rio de Janeiro, oferecendo uma consultoria que vai muito além da burocracia: entregamos soluções práticas, executadas no terreno e aprovadas nos órgãos.
            </p>
          </div>
        </div>

        <div class="reveal reveal-delay-2 lg:col-span-6">
          <div class="rounded-3xl border border-white/12 bg-white/[0.03] p-8 sm:p-10 lg:sticky lg:top-32">
            <h3 class="font-display text-[1.6rem] font-semibold text-white">Tudo para licenciar em um só lugar</h3>
            <ul class="mt-7">
              {escopo.map((e, i) => (
                <li class="mb-2 flex items-start gap-4 rounded-2xl bg-white/[0.05] p-4">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-gold text-xs font-bold text-brand-night">{i + 1}</span>
                  <span class="leading-relaxed text-white/60"><strong class="font-semibold text-white">{e.b}</strong> — {e.d}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SETORES -->
  <section class="section-luxury bg-neutral-paper">
    <div class="section-inner">
      <div class="reveal grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <span class="eyebrow"><span class="idx">05</span> Setores</span>
          <h2 class="mt-7 text-display-lg font-bold text-neutral-ink">Empreendimentos que Regularizamos</h2>
        </div>
        <p class="lede lg:col-span-6 lg:pt-16">Indústrias, construtoras, empreendimentos imobiliários, comércios e infraestrutura. Se você constrói, expande ou muda de atividade no RJ, precisa estar regularizado.</p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {setores.map((s, i) => (
          <div class="reveal card card-hover p-7">
            <div class="flex items-center justify-between">
              <span class="icon-tile">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={s.icon} /></svg>
              </span>
              <span class="text-sm font-semibold text-neutral-ink-muted">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="mt-8 text-[1.3rem] font-bold tracking-[-0.03em] text-neutral-ink">{s.t}</h3>
            <p class="mt-3 leading-relaxed text-neutral-ink-muted">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AVALIAÇÕES -->
  <GoogleReviews class="!pt-0" />

  <!-- CTA -->
  <section class="px-2 py-3 sm:px-3">
    <div class="reveal">
      <CTABox />
    </div>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
