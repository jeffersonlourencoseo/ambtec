---
interface Props {
  eyebrow?: string;
  crumbs?: { label: string; href?: string }[];
  image?: boolean;
}
const { eyebrow, crumbs = [], image = false } = Astro.props;
---

<section class="page-hero" data-hero-dark>
  {image && (
    <img
      src="/images/hero-ambiental.webp"
      alt=""
      aria-hidden="true"
      decoding="async"
      class="hero-zoom absolute inset-0 h-full w-full object-cover opacity-[0.22]"
    />
  )}
  <div class="absolute inset-0 bg-gradient-to-b from-brand-deep/40 via-brand-deep/70 to-brand-deep"></div>
  <div class="topo text-white/[0.05]"></div>
  <div class="noise-overlay absolute inset-0"></div>

  <div class="wrap relative z-10">
    {crumbs.length > 0 && (
      <nav aria-label="Você está em" class="rise mb-10 flex flex-wrap items-center gap-2 text-[0.8rem] font-semibold text-white/45">
        <a href="/" class="transition-colors hover:text-white">Início</a>
        {crumbs.map((c) => (
          <>
            <span aria-hidden="true" class="text-accent-gold/70">/</span>
            {c.href ? <a href={c.href} class="transition-colors hover:text-white">{c.label}</a> : <span class="text-white/70">{c.label}</span>}
          </>
        ))}
      </nav>
    )}
    {eyebrow && <span class="rise eyebrow eyebrow-light mb-8">{eyebrow}</span>}
    <div class="max-w-5xl">
      <slot />
    </div>
    <slot name="after" />
  </div>
</section>
