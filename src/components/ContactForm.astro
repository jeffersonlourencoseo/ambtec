---
import { SITE_CONFIG } from '../data/config.ts';
const waNumber = SITE_CONFIG.company.whatsapp.replace(/\D/g, '');
---

<form id="contact-form" data-wa={waNumber} class="space-y-6 rounded-3xl border border-neutral-line bg-white p-6 shadow-soft sm:p-10">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <label for="nome" class="field-label">Nome completo</label>
      <input
        type="text"
        id="nome"
        name="nome"
        required
        class="field"
        placeholder="Seu nome"
      />
    </div>
    <div>
      <label for="email" class="field-label">E-mail</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="field"
        placeholder="seu@email.com"
      />
    </div>
  </div>

  <div>
    <label for="telefone" class="field-label">Telefone / WhatsApp</label>
    <input
      type="tel"
      id="telefone"
      name="telefone"
      required
      class="field"
      placeholder="(00) 00000-0000"
    />
  </div>

  <div>
    <label for="empresa" class="field-label">Empreendimento</label>
    <input
      type="text"
      id="empresa"
      name="empresa"
      class="field"
      placeholder="Nome da empresa ou propriedade"
    />
  </div>

  <div>
    <label for="servico" class="field-label">Serviço de interesse</label>
    <select
      id="servico"
      name="servico"
      class="field field-select"
    >
      <option value="">Selecione um serviço</option>
      <option value="licenciamento">Licenciamento Ambiental</option>
      <option value="eia-rima">Avaliação de Impacto (EIA/RIMA)</option>
      <option value="gestao">Gestão Ambiental</option>
      <option value="car">Cadastro Ambiental Rural (CAR)</option>
      <option value="reserva-legal">Compensação de Reserva Legal</option>
      <option value="auditoria">Auditoria Ambiental</option>
      <option value="outro">Outro</option>
    </select>
  </div>

  <div>
    <label for="mensagem" class="field-label">Mensagem</label>
    <textarea
      id="mensagem"
      name="mensagem"
      rows="4"
      required
      class="field resize-none"
      placeholder="Descreva sua necessidade ambiental..."
    ></textarea>
  </div>

  <button
    type="submit"
    class="btn-luxury w-full !py-[1.1rem]"
  >
    Solicitar Proposta Técnica
  </button>
  <p class="text-xs text-neutral-ink-muted text-center">Ao enviar, abrimos o WhatsApp da Ambtec com a sua mensagem pronta.</p>
</form>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var f = new FormData(form);
      var servico = form.querySelector('#servico');
      var servicoTxt = servico && servico.value ? servico.options[servico.selectedIndex].text : 'Não informado';
      var msg = 'Olá, vim pelo site e gostaria de uma proposta técnica.\n' +
        'Nome: ' + (f.get('nome') || '') + '\n' +
        'E-mail: ' + (f.get('email') || '') + '\n' +
        'Telefone: ' + (f.get('telefone') || '') + '\n' +
        'Empreendimento: ' + (f.get('empresa') || 'Não informado') + '\n' +
        'Serviço: ' + servicoTxt + '\n' +
        'Mensagem: ' + (f.get('mensagem') || '');
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'generate_lead', { form_id: 'contato', page_path: location.pathname });
      }
      window.open('https://wa.me/' + form.getAttribute('data-wa') + '?text=' + encodeURIComponent(msg), '_blank', 'noopener');
    });
  })();
</script>
