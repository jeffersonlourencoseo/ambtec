---
interface Props {
  title: string;
  description: string;
  icon?: string;
  index?: number;
}

const { title, description, icon, index } = Astro.props;
---

<div class="group relative flex h-full flex-col rounded-2xl border border-neutral-line bg-white/50 p-8 transition-all duration-500 ease-out-expo hover:-translate-y-1 hover:border-brand-mid/30 hover:bg-white hover:shadow-lift lg:p-10">
  <div class="mb-10 flex items-start justify-between">
    {icon && (
      <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-light/70 text-brand-deep transition-colors duration-300 group-hover:border-brand-deep group-hover:bg-brand-deep group-hover:text-accent-gold">
        <svg class="h-[22px] w-[22px]" fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
        </svg>
      </span>
    )}
    {typeof index === 'number' && <span class="text-sm font-semibold text-neutral-ink-muted">{String(index).padStart(2, '0')}</span>}
  </div>

  <h3 class="font-display text-[1.5rem] font-semibold leading-tight tracking-tight text-neutral-ink">{title}</h3>
  <p class="mt-4 flex-1 leading-relaxed text-neutral-ink-muted">{description}</p>

  <div class="mt-8 flex items-center gap-2 text-sm font-semibold text-neutral-ink">
    <span>Saiba mais</span>
    <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
  </div>
</div>
