---
import Logo from './Logo.astro';
import { SITE_CONFIG } from '../data/config.ts';

const whatsappUrl = `https://wa.me/${SITE_CONFIG.company.whatsapp}?text=${encodeURIComponent('Olá, vi o site no google e gostaria de mais informações!')}`;
const { address } = SITE_CONFIG.company;

const servicos = [
  { label: 'Licenciamento', href: '/servicos/licenciamento-ambiental' },
  { label: 'Compensação', href: '/servicos/compensacao-ambiental' },
  { label: 'Reflorestamento', href: '/servicos/reflorestamento' },
  { label: 'Podas e Supressão', href: '/servicos/podas-e-supressao-vegetal' },
  { label: 'Inventário', href: '/servicos/inventario-florestal-e-fauna' },
];
const institucional = [
  { label: 'Quem Somos', href: '/sobre' },
  { label: 'Blog', href: '/blog' },
  { label: 'Perguntas frequentes', href: '/faq' },
  { label: 'Contato', href: '/contato' },
  { label: 'Privacidade', href: '/privacidade' },
  { label: 'Termos', href: '/termos' },
];
---

<footer class="relative mx-2 mb-2 mt-3 overflow-hidden rounded-[1.75rem] bg-brand-night text-white sm:mx-3 sm:mb-3 md:rounded-[2.25rem]">
  <div class="topo text-white/[0.035]"></div>
  <div class="noise-overlay absolute inset-0"></div>

  <div class="relative z-10">
    <!-- Faixa de chamada -->
    <div class="wrap">
      <div class="flex flex-col gap-10 border-b border-white/10 py-16 md:py-20 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <span class="eyebrow eyebrow-light">Próximo passo</span>
          <h3 class="mt-6 text-display-lg font-bold text-white">
            Pronto para <em class="text-accent-gold">regularizar</em> seu empreendimento?
          </h3>
          <p class="mt-5 max-w-lg text-white/55">
            Especialistas em protocolar e acompanhar licenciamentos junto ao INEA e às Secretarias Municipais de Meio Ambiente do RJ.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-luxury-gold">
            Falar com especialista
            <svg class="arr h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
          </a>
          <a href={`tel:${SITE_CONFIG.company.phone}`} class="btn-luxury-dark">{SITE_CONFIG.company.phoneFormatted}</a>
        </div>
      </div>
    </div>

    <!-- Grade principal -->
    <div class="wrap py-16 md:py-20">
      <div class="grid grid-cols-2 gap-x-8 gap-y-12 lg:grid-cols-12">
        <div class="col-span-2 lg:col-span-4">
          <a href="/" aria-label="Ambtec — página inicial" class="inline-block"><Logo /></a>
          <p class="mt-7 max-w-sm text-[0.95rem] leading-relaxed text-white/50">
            Consultoria ambiental no Rio de Janeiro. Licenciamento junto ao INEA e Secretarias Municipais de Meio Ambiente, além de compensação ambiental, inventário florestal, podas legalizadas e reflorestamento. Tudo em um só lugar.
          </p>
        </div>

        <div class="lg:col-span-2 lg:col-start-6">
          <h4 class="text-sm font-semibold text-white">Serviços</h4>
          <ul class="mt-6 space-y-3.5">
            {servicos.map((l) => (
              <li><a href={l.href} class="text-[0.95rem] text-white/60 transition-colors hover:text-white">{l.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="lg:col-span-2">
          <h4 class="text-sm font-semibold text-white">Institucional</h4>
          <ul class="mt-6 space-y-3.5">
            {institucional.map((l) => (
              <li><a href={l.href} class="text-[0.95rem] text-white/60 transition-colors hover:text-white">{l.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="col-span-2 lg:col-span-3">
          <h4 class="text-sm font-semibold text-white">Contato</h4>
          <ul class="mt-6 space-y-4 text-[0.95rem] text-white/70">
            <li>
              <a href={SITE_CONFIG.company.mapsUrl} target="_blank" rel="noopener noreferrer" class="leading-relaxed transition-colors hover:text-accent-gold">
                {address.street} — {address.neighborhood}<br />{address.city} — {address.state} · CEP {address.zipCode}
              </a>
            </li>
            <li><a href={`tel:${SITE_CONFIG.company.phone}`} class="transition-colors hover:text-accent-gold">{SITE_CONFIG.company.phoneFormatted}</a></li>
            <li><a href={`mailto:${SITE_CONFIG.company.email}`} class="transition-colors hover:text-accent-gold">{SITE_CONFIG.company.email}</a></li>
            <li class="text-white/45">Seg. a sex. 08h–18h · Sáb. 09h–13h</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Assinatura -->
    <div class="wrap">
      <div class="flex flex-col gap-3 border-t border-white/10 py-8 text-[0.82rem] text-white/40 md:flex-row md:items-center md:justify-between">
        <p>© 2026 Ambtec · CNPJ {SITE_CONFIG.company.cnpj}</p>
        <p>22°56′15″S · 43°34′30″W — Guaratiba, Rio de Janeiro</p>
      </div>
    </div>

    <div class="pointer-events-none select-none overflow-hidden" aria-hidden="true">
      <p class="wrap -mb-[0.22em] font-display text-[24vw] font-bold leading-[0.78] tracking-[-0.07em] text-white/[0.05] lg:text-[19rem]">ambtec</p>
    </div>
  </div>
</footer>
