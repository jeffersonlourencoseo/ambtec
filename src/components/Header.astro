---
import Logo from './Logo.astro';
import { SITE_CONFIG } from '../data/config.ts';

const navLinks = [
  { label: 'Início', href: '/' },
  { label: 'Quem Somos', href: '/sobre' },
  { label: 'Serviços', href: '/servicos' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contato', href: '/contato' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-5 sm:pt-5" id="main-header">
  <div
    id="header-pill"
    class="mx-auto flex h-[64px] max-w-site items-center justify-between gap-4 rounded-full border border-neutral-ink/[0.06] bg-white/85 pl-5 pr-2 shadow-[0_8px_30px_-12px_rgba(12,29,22,0.25)] backdrop-blur-xl transition-all duration-500 sm:pl-6"
  >
    <a href="/" aria-label="Ambtec — página inicial" class="shrink-0 transition-opacity hover:opacity-80">
      <Logo tone="dark" />
    </a>

    <nav class="hidden items-center gap-1 rounded-full bg-neutral-cream/70 p-1 lg:flex" aria-label="Principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'rounded-full px-4 py-2 text-[0.9rem] font-semibold transition-all duration-300',
            isActive(link.href) ? 'bg-white text-neutral-ink shadow-[0_1px_3px_rgba(12,29,22,0.12)]' : 'text-neutral-ink-muted hover:text-neutral-ink',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={`tel:${SITE_CONFIG.company.phone}`} class="hidden text-[0.88rem] font-semibold text-neutral-ink-muted transition-colors hover:text-neutral-ink xl:inline">
        {SITE_CONFIG.company.phoneFormatted}
      </a>
      <a href="/contato" class="btn-luxury !py-3 !pl-5 !pr-2 text-[0.88rem]">
        Solicitar diagnóstico
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent-gold text-brand-night">
          <svg class="arr h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M8 7h9v9" /></svg>
        </span>
      </a>
    </div>

    <button
      id="mobile-menu-toggle"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-drawer"
      class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-brand-deep text-white transition-colors hover:bg-brand-forest lg:hidden"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
        <path stroke-linecap="round" d="M4 9h16M4 15h10" />
      </svg>
    </button>
  </div>
</header>

<!-- Menu mobile -->
<div id="mobile-drawer" class="fixed inset-0 z-[9999] hidden" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="absolute inset-0 overflow-hidden bg-brand-night">
    <div class="topo text-white/[0.06]"></div>
    <div class="glow -right-24 top-10 h-72 w-72 bg-accent-gold/20"></div>
  </div>

  <div class="relative z-10 flex h-full flex-col">
    <div class="flex items-center justify-between px-6 pt-6">
      <Logo />
      <button
        id="mobile-menu-close"
        aria-label="Fechar menu"
        class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="mt-10 flex flex-1 flex-col px-6" aria-label="Menu mobile">
      {navLinks.map((link) => (
        <a href={link.href} class="group flex items-center justify-between border-b border-white/10 py-5 text-white">
          <span class="font-display text-[2rem] font-semibold tracking-tight transition-colors group-hover:text-accent-gold">{link.label}</span>
          <svg class="h-5 w-5 text-white/40 transition-transform group-hover:translate-x-1 group-hover:text-accent-gold" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
        </a>
      ))}
    </nav>

    <div class="px-6 pb-10 pt-8">
      <a href="/contato" class="btn-luxury-gold w-full">Solicitar diagnóstico</a>
      <a href={`tel:${SITE_CONFIG.company.phone}`} class="mt-5 block text-center text-sm font-semibold text-white/60">{SITE_CONFIG.company.phoneFormatted}</a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var pill = document.getElementById('header-pill');
    function onScroll() {
      var s = window.scrollY > 24;
      pill.style.background = s ? 'rgba(255,255,255,0.95)' : '';
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    var toggle = document.getElementById('mobile-menu-toggle');
    var drawer = document.getElementById('mobile-drawer');
    var closeBtn = document.getElementById('mobile-menu-close');
    function openMenu() {
      drawer.classList.remove('hidden');
      drawer.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }
    function closeMenu() {
      drawer.classList.add('hidden');
      drawer.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
    toggle && toggle.addEventListener('click', openMenu);
    closeBtn && closeBtn.addEventListener('click', closeMenu);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeMenu(); });
    drawer.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', closeMenu); });
  })();
</script>
