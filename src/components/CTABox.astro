---
import { SITE_CONFIG } from '../data/config.ts';

interface Props {
  title?: string;
  subtitle?: string;
  variant?: 'light' | 'dark';
}

const {
  title = 'Solicite uma proposta técnica para o seu projeto',
  subtitle = 'Analisamos as particularidades do seu empreendimento e apresentamos uma solução ambiental personalizada, com cronograma definido e equipe multidisciplinar alocada.',
  variant = 'dark',
} = Astro.props;

const isDark = variant === 'dark';
const whatsappUrl = `https://wa.me/${SITE_CONFIG.company.whatsapp}?text=${encodeURIComponent('Olá, vi o site no google e gostaria de mais informações!')}`;
---

<div class:list={['relative overflow-hidden rounded-[1.75rem] md:rounded-[2.25rem]', isDark ? 'bg-brand-deep text-white' : 'bg-brand-light/60 text-neutral-ink']}>
  <div class:list={['topo', isDark ? 'text-white/[0.05]' : 'text-brand-deep/[0.06]']}></div>
  {isDark && <div class="glow -bottom-24 right-10 h-80 w-80 bg-accent-gold/20"></div>}

  <div class="wrap relative z-10 grid gap-10 py-16 md:py-24 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-7">
      <span class:list={['eyebrow', isDark && 'eyebrow-light']}>Diagnóstico sem compromisso</span>
      <h2 class="mt-6 text-display-lg font-bold">{title}</h2>
      <p class:list={['mt-5 max-w-2xl text-lg leading-relaxed', isDark ? 'text-white/60' : 'text-neutral-ink-muted']}>{subtitle}</p>
    </div>
    <div class="lg:col-span-5">
      <div class:list={['rounded-3xl p-6 sm:p-7', isDark ? 'bg-white/[0.06] ring-1 ring-white/10 backdrop-blur-md' : 'bg-white']}>
        <ul class="space-y-3">
          {['Análise do enquadramento', 'Escopo e cronograma definidos', 'Uma equipe do começo ao fim'].map((t) => (
            <li class="flex items-center gap-3 text-[0.95rem] font-semibold">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-accent-gold text-brand-night">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12.5 4.5 4.5L19 7.5" /></svg>
              </span>
              {t}
            </li>
          ))}
        </ul>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class={`${isDark ? 'btn-luxury-gold' : 'btn-luxury'} flex-1`}>
            <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Solicitar orçamento
          </a>
          <a href={`tel:${SITE_CONFIG.company.phone}`} class={`${isDark ? 'btn-luxury-dark' : 'btn-luxury-outline'} flex-1`}>Falar por telefone</a>
        </div>
      </div>
    </div>
  </div>
</div>
